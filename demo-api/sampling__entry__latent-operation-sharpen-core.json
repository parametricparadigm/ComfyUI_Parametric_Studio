{"id": "latent-operation-sharpen-core", "name": "LatentOperationSharpen", "family": "latent", "subfamily": "sharpen", "plain": "Sharpens direction, keeps magnitude. It unit-normalises per pixel, convolves with a kernel built from a negative Gaussian with a compensated centre, then multiplies magnitude back. The result is not renormalised, so the norm drifts slightly.", "math": "L=\u2016x\u2016\u2082+1e\u22126, u=x/L\nk = \u221210\u03b1\u00b7G(r\u00b72+1,\u03c3); k[c,c] \u2190 k[c,c] \u2212 \u03a3k + 1\nout = L\u00b7conv2d(reflect_pad(u), k) per channel\nG is built on a \u22121..1 grid, so \u03c3 is relative to kernel extent, not cells.", "props": {"operates_on": "LATENT_OPERATION", "params": "sharpen_radius=9, sigma=1.0, alpha=0.1"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_latent.py:470", "symbol": "luminance"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:478", "symbol": "alpha * -10"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:484", "symbol": "luminance * sharpened"}, {"where": "ComfyUI/comfy_extras/nodes_post_processing.py:74", "symbol": "def gaussian_kernel"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["LatentOperationSharpen"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "LatentOperationSharpen"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}