{"id": "sag-core", "name": "Self-Attention Guidance (core)", "family": "guidance", "subfamily": "perturbed-pass", "plain": "Saves the negative pass's self-attention map, blurs the negative's x0 prediction only where attention is high, re-noises it, and runs another negative pass. The difference adds guidance for the attended areas.", "math": "m = (GAP of attention scores, summed) > 1.0, upsampled to latent\nx\u0302_deg = blur(x\u0302_u, 9\u00d79, \u03c3_b)\u00b7m + x\u0302_u\u00b7(1\u2212m)\nx_deg = x\u0302_deg + x \u2212 x\u0302_u\nx\u0302_s = M(x_deg; n)\nx\u0302 = x\u0302_cfg + w\u00b7(x\u0302_deg \u2212 x\u0302_s)", "props": {"hook": "post_cfg", "extra_model_calls": "1, plus uncond forced at cfg 1", "params": "scale=0.5, blur_sigma=2.0"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_sag.py:56", "symbol": "def create_blur_map"}, {"where": "ComfyUI/comfy_extras/nodes_sag.py:175", "symbol": "return cfg_result + (degraded - sag) * sag_scale"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["SelfAttentionGuidance"], "note": "", "verdict": "", "risks": [], "res4lyf": false}, {"pack": "17Retoucher__ComfyUI_Fooocus", "author": "17Retoucher", "licence": "none-found", "kind": "copy", "nodes": [], "note": "ldm_patched copy, not diffed", "verdict": "SKIP", "risks": ["installs software at runtime", "runs decoded or dynamic code", "paid or partner API", "patches torch or ComfyUI globally", "downloads models"], "res4lyf": false}, {"pack": "Extraltodeus__ComfyUI-AutomaticCFG", "author": "Extraltodeus", "licence": "Apache-2.0", "kind": "variant", "nodes": [], "note": "nodes_sag_custom.py, see automatic-cfg entry", "verdict": "MAYBE", "risks": ["runs decoded or dynamic code", "patches torch or ComfyUI globally"], "res4lyf": false}, {"pack": "FlareAI-Studios__advanced-cfg-controller", "author": "FlareAI-Studios", "licence": "none-found", "kind": "copy", "nodes": [], "note": "nodes_sag_custom.py, not