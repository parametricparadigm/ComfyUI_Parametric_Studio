{"id": "ms-flux-shift", "name": "Flux shift (flux_time_shift, ModelSamplingFlux)", "family": "scheduler", "subfamily": "core-model-sampling", "plain": "Flux's table uses an exponential shift \u03bc. The node computes \u03bc from image area on a line through two reference points, so larger images get more shift. The table has 10000 entries and timestep equals sigma.", "math": "flux_time_shift(\u03bc,1,t) = e^\u03bc/(e^\u03bc + (1/t\u22121)).\nNode: tokens = w\u00b7h/(8\u00b78\u00b72\u00b72); \u03bc = tokens\u00b7m + b, m=(max_shift\u2212base_shift)/(4096\u2212256), b=base_shift\u2212256m.\nTable: t=k/10000, k=1..10000.", "props": {"shape": "exponential shift, area-driven", "params": "max_shift=1.15, base_shift=0.5, width=1024, height=1024", "needs_model_sampling": true}, "evidence": [{"where": "ComfyUI/comfy/model_sampling.py:413", "symbol": "flux_time_shift"}, {"where": "ComfyUI/comfy/model_sampling.py:416", "symbol": "ModelSamplingFlux"}, {"where": "ComfyUI/comfy_extras/nodes_model_advanced.py:166", "symbol": "ModelSamplingFlux"}, {"where": "ComfyUI/comfy_extras/nodes_model_advanced.py:188", "symbol": "shift"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["ModelSamplingFlux"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "ModelSamplingFlux"}, "family_fit": [{"family": "Flux", "why": "supported_models default shift 1.15", "label": "from code", "source": "ComfyUI/comfy/supported_models.py:740"}], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}