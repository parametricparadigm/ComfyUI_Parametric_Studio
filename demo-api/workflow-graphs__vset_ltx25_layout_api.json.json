{"name": "vset_ltx25_layout_api.json", "format": "api", "fills": ["first", "height", "layout", "length", "prefix", "prompt", "seed", "width"], "graph": {"src": {"class_type": "LoadVideo", "inputs": {"file": "${layout}"}}, "comp": {"class_type": "GetVideoComponents", "inputs": {"video": ["src", 0]}}, "still": {"class_type": "LoadImage", "inputs": {"image": "${first}"}}, "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.5-video-vae-conv-bf16.safetensors"}}, "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}}, "lora": {"class_type": "LTXICLoRALoaderModelOnly", "inputs": {"model": ["unet", 0], "lora_name": "ltx-2.5-22b-ic-lora-layout-to-render-1.0.safetensors", "strength_model": 1.0}}, "upm": {"class_type": "LatentUpscaleModelLoader", "inputs": {"model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors"}}, "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}}, "pos": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": "${prompt}"}}, "neg": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": ""}}, "cond": {"class_type": "LTXVConditioning", "inputs": {"positive": ["pos", 0], "negative": ["neg", 0], "frame_rate": 24.0}}, "lat": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": "${width}", "height": "${height}", "length": "${length}", "batch_size": 1}}, "g1v": {"class_type": "LTXAddVideoICLoRAGuide", "inputs": {"positive": ["cond", 0], "negative": ["cond", 1], "vae": ["vae", 0], "latent": ["lat", 0], "image": ["comp", 0], "frame_idx": 0, "strength": 1.0, "latent_downscale_factor": ["lora", 1], "crop": "disabled", "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64}}, "g1s": {"class_type": "LTXAddVideoICLoRAGuide", "inputs": {"positive": ["g1v", 0], "negative": ["g1v", 1], "va