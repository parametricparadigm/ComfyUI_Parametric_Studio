{"id": "shape-discard-penultimate", "name": "Discard penultimate sigma (KSampler rule)", "family": "scheduler", "subfamily": "core-shaper", "plain": "For dpm_2, dpm_2_ancestral, uni_pc and uni_pc_bh2, KSampler builds the schedule with one more step and removes the second-to-last sigma, so the last jump goes straight to 0. This is an automatic shaper tied to the sampler name; a SamplerCustom workflow with its own sigmas does not get it.", "math": "\u03c3 = schedule(steps+1); \u03c3' = \u03c3[:\u22122] + [\u03c3[\u22121]].", "props": {"shape": "remove second-to-last", "params": "sampler in DISCARD_PENULTIMATE_SIGMA_SAMPLERS", "needs_model_sampling": true}, "evidence": [{"where": "ComfyUI/comfy/samplers.py:1403", "symbol": "DISCARD_PENULTIMATE_SIGMA_SAMPLERS"}, {"where": "ComfyUI/comfy/samplers.py:1418", "symbol": "calculate_sigmas"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["KSampler"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "KSampler"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}