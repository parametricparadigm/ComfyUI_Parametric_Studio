{"id": "h3-motion-cache", "name": "H3 MotionCache", "family": "patch", "subfamily": "step-cache", "plain": "An EasyCache-style predictor for H3 that weights video change by where frames differ most, and also watches audio. It predicts output change from input change and skips when the accumulated estimate stays low.", "math": "w = 1+s\u00b7(frame delta / mean delta), renormalised to mean 1, from denoised video.\nscore = max(R_v\u00b7mean(w|\u0394v|)/\u2016y_v\u2016_w, R_a\u00b7mean|\u0394a|/\u2016y_a\u2016)\nA += score; reuse if A<\u03c4 and skips<max; step>warmup; window active.", "props": {"hook": "DIFFUSION_MODEL and OUTER_SAMPLE wrappers (PATCH_KEY minimax_h3_motioncache)", "architectures": "MiniMax H3", "params": "reuse_threshold, motion_strength, warmup_steps, max_consecutive_skips"}, "evidence": [{"where": "JayDataEngineer__ComfyUI-MiniMax-H3-MotionCache-FastVAE/motion_cache.py:121", "symbol": "motion_strength"}, {"where": "JayDataEngineer__ComfyUI-MiniMax-H3-MotionCache-FastVAE/motion_cache.py:148", "symbol": "video_score"}, {"where": "JayDataEngineer__ComfyUI-MiniMax-H3-MotionCache-FastVAE/motion_cache.py:165", "symbol": "reuse_threshold"}, {"where": "JayDataEngineer__ComfyUI-MiniMax-H3-MotionCache-FastVAE/motion_cache.py:217", "symbol": "motioncache_forward_wrapper"}], "providers": [{"pack": "JayDataEngineer__ComfyUI-MiniMax-H3-MotionCache-FastVAE", "author": "JayDataEngineer", "licence": "", "kind": "original", "nodes": [], "note": "Same pack also has fast_vae_decode, not catalogued", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": [], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}