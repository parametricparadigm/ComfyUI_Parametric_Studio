{"id": "clamp-denoised-vae-roundtrip", "name": "ClampDenoised VAE round trip", "family": "guidance", "subfamily": "post cfg", "plain": "Each step, decodes the denoised latent to pixels, clamps to 0-1, and encodes it again. It forces the prediction into the range of the VAE, and costs one VAE decode and encode per step. It does nothing on latents that are not 4D, so it skips video.", "math": "x\u0302\u2080 \u2190 E(clamp(D(x\u0302\u2080),0,1)), only when x\u0302\u2080.ndim=4.", "props": {"hook": "post_cfg", "extra_model_calls": "0 UNet, 1 VAE decode + 1 VAE encode per step", "params": "vae"}, "evidence": [{"where": "Lakonik__ComfyUI-piFlow/clamp_denoised.py:14", "symbol": "post_cfg_function"}], "providers": [{"pack": "Lakonik__ComfyUI-piFlow", "author": "Lakonik", "licence": "Apache-2.0", "kind": "original", "nodes": ["ClampDenoised"], "note": "", "verdict": "TRY", "risks": ["patches torch or ComfyUI globally"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["patches torch or ComfyUI globally"], "flagged_providers": 1, "licences": ["Apache-2.0"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}