{"id": "piflow-dx-policy", "name": "DX policy (grid or polynomial)", "family": "sampler", "subfamily": "policy flow", "plain": "The model predicts N clean-image estimates laid out across one time segment. The policy interpolates between them, or uses them as polynomial coefficients. It ignores where x has moved when choosing x\u0302\u2080, unlike GMFlow.", "math": "x\u0302\u2080\u1d62=x_src\u2212\u03c3_src\u00b7out\u1d62. raw t=\u03c3/(s+(1\u2212s)\u03c3).\nGrid: \u03c4=(raw t\u2212raw_dst)/segment, linear interpolation over the N points.\nPolynomial: first coefficient kept, others stored as differences from it; x\u0302\u2080=\u03a3 (raw_src\u2212raw t)\u2071 c\u1d62.\n\u03c0=(x\u2212x\u0302\u2080)/\u03c3.", "props": {"order": 1, "stages": 0, "stochastic": "deterministic", "multistep": false, "prediction_space": "x0 grid"}, "evidence": [{"where": "Lakonik__ComfyUI-piFlow/modules/piflow_policies/dx.py:7", "symbol": "class DXPolicy"}, {"where": "Lakonik__ComfyUI-piFlow/modules/piflow_policies/dx.py:61", "symbol": "_interpolate"}, {"where": "Lakonik__ComfyUI-piFlow/modules/piflow_policies/dx.py:96", "symbol": "self.mode == 'polynomial'"}], "providers": [{"pack": "Lakonik__ComfyUI-piFlow", "author": "Lakonik", "licence": "Apache-2.0", "kind": "original", "nodes": [], "note": "", "verdict": "TRY", "risks": ["patches torch or ComfyUI globally"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["patches torch or ComfyUI globally"], "flagged_providers": 1, "licences": ["Apache-2.0"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}