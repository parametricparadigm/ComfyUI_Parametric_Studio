{"id": "gigachad-cfg-rescale-noop", "name": "Gigachad CFG rescale", "family": "guidance", "subfamily": "rescale", "plain": "Cites the rescale paper, but the factor divides x.std() by itself, not by a cond std. So it is about 1 and the node does essentially nothing at any strength.", "math": "x_norm=x\u00b7std(x)/(std(x)+1e-8)\u2248x; out=m\u00b7x_norm+(1\u2212m)x\u2248x.", "props": {"hook": "cfg_function", "extra_model_calls": 0, "params": "cfg_rescale"}, "evidence": [{"where": "Winnougan__comfyui-gigachad/gigachad_sampler_custom_advanced.py:28", "symbol": "_apply_cfg_rescale"}, {"where": "Winnougan__comfyui-gigachad/gigachad_sampler_custom_advanced.py:139", "symbol": "_rescaled_cfg"}], "providers": [{"pack": "Winnougan__comfyui-gigachad", "author": "Winnougan", "licence": "Apache-2.0", "kind": "original", "nodes": [], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "No-op rescale: it never compares with the cond prediction.", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["Apache-2.0"], "verdicts": [], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}