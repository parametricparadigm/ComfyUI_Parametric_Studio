{"id": "core-ancestral-rf", "name": "Rectified-flow ancestral renoise (RF variants)", "family": "noise", "subfamily": "ancestral", "plain": "Flow models cannot use the VE split, so core has a separate rule. It shrinks x toward the prediction, rescales up by alpha ratio and adds noise so the marginal is right at next sigma. Note the eta semantics differ from the VE version.", "math": "ratio = 1 + (\u03c3_next/\u03c3 \u2212 1)\u00b7\u03b7; \u03c3_down = \u03c3_next\u00b7ratio. \u03b1_next=1\u2212\u03c3_next; \u03b1_down=1\u2212\u03c3_down.\nc = \u221a(\u03c3_next\u00b2 \u2212 \u03c3_down\u00b2\u00b7\u03b1_next\u00b2/\u03b1_down\u00b2).\nx \u2190 (\u03c3_down/\u03c3)\u00b7x + (1\u2212\u03c3_down/\u03c3)\u00b7x0; if \u03b7>0: x \u2190 (\u03b1_next/\u03b1_down)\u00b7x + \u03b5\u00b7s_noise\u00b7noise_scale\u00b7c. Last step returns x0.", "props": {"distribution": "from noise sampler", "spectrum": "from noise sampler", "when_applied": "per-step", "normalizes_variance": "variance-preserving by construction when s_noise\u00b7noise_scale=1"}, "evidence": [{"where": "ComfyUI/comfy/k_diffusion/sampling.py:240", "symbol": "sample_euler_ancestral_RF"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:261", "symbol": "renoise_coeff"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": [], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"sampler_name": "euler_ancestral"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": true, "rendered_ids": ["sampler-euler_ancestral"], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}