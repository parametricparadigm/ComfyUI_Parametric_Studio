{"id": "tc-pade", "name": "TC-Pad\u00e9 residual predictor", "family": "patch", "subfamily": "feature-forecast", "plain": "Predicts the whole transformer stack's residual from recent residuals using a rational (Pad\u00e9-like) formula with a per-element stability factor. Predicts on all non-interval steps inside a range, regardless of how much the signal changed.", "math": "If start<step<end and step%interval\u22600: x = x_in + R\u0302.\n\u03c9 = exp(\u22125|R1\u2212R2|/(avg+1e-7)); b0=2\u03c9, b1=\u03c9; a1=\u22130.1\u03c9 by curvature sign.\nR\u0302 = (b0\u00b7R1 \u2212 b1\u00b7R2)/(1 + a1\u00b7sign), clamped around .6R1+.4R2 by \u00b1max(.5|R1\u2212R2|,.1avg), blended with weight .7\u03c9+.3.\nShort history uses weighted extrapolation .4,.3,.2,.1.", "props": {"hook": "forward patch (per adapter)", "architectures": "flux, wan2.1", "params": "start_step=4,end=-1,interval=8,n_threshold=1.4,order=3,history=6"}, "evidence": [{"where": "jiajianxie__ComfyUI-AccelDiff/model/tcpade/pade_utils.py:84", "symbol": "stability_factor"}, {"where": "jiajianxie__ComfyUI-AccelDiff/model/tcpade/pade_utils.py:105", "symbol": "result"}, {"where": "jiajianxie__ComfyUI-AccelDiff/model/tcpade/pade_utils.py:115", "symbol": "blend_factor"}, {"where": "jiajianxie__ComfyUI-AccelDiff/model/tcpade/nodes.py:47", "symbol": "use_predict"}], "providers": [{"pack": "jiajianxie__ComfyUI-AccelDiff", "author": "jiajianxie", "licence": "Apache-2.0", "kind": "variant", "nodes": ["TCPade", "DynamicModelParamsNode"], "note": "Header says ported from Alibaba-VELLDEPTH/TC_Pade", "verdict": "TRY", "risks": ["patches torch or ComfyUI globally"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["patches torch or ComfyUI globally"], "flagged_providers": 1, "licences": ["Apache-2.0"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "