{"name": "oneclick_relight_api.json", "format": "api", "fills": ["image", "prompt", "seed"], "graph": {"unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_edit_2509_int8_convrot.safetensors", "weight_dtype": "default"}}, "fast": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["unet", 0], "lora_name": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}}, "look": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["fast", 0], "lora_name": "Qwen-Image-Edit-2509-Relight.safetensors", "strength_model": 1.0}}, "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["look", 0], "shift": 3.0}}, "norm": {"class_type": "CFGNorm", "inputs": {"model": ["shift", 0], "strength": 1, "pre_cfg": false}}, "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}}, "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}}, "src": {"class_type": "LoadImage", "inputs": {"image": "${image}"}}, "fit": {"class_type": "FluxKontextImageScale", "inputs": {"image": ["src", 0]}}, "lat": {"class_type": "VAEEncode", "inputs": {"pixels": ["fit", 0], "vae": ["vae", 0]}}, "neg": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["fit", 0], "prompt": ""}}, "pos1": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["fit", 0], "prompt": "${prompt}"}}, "ks1": {"class_type": "KSampler", "inputs": {"model": ["norm", 0], "positive": ["pos1", 0], "negative": ["neg", 0], "latent_image": ["lat", 0], "seed": "${seed}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}}, "dec1": {"class_type": "VAEDecode", "inputs": {"samples": ["ks1", 0], "vae": ["vae", 0]}}, "save1": {"class_type": "SaveImage", "inputs": {"images": ["dec1", 0], "filename_prefix": "oneclick_relight/relit"}}}}