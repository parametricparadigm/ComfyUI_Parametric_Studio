{"id": "freeu-v1-core", "name": "FreeU", "family": "latent", "subfamily": "freeu", "plain": "UNet output-block patch. It multiplies half of the backbone channels and attenuates the very low frequencies of the skip features, at two block widths. Only works on UNets with model_channels. Family and hook details belong to the patch list; included here for the Fourier maths.", "math": "at width ch\u00b74: (b1,s1); ch\u00b72: (b2,s2)\nh[:, :C/2] *= b\nhsp: F=fftshift(fft2(hsp)); F[centre \u00b11, centre \u00b11] *= s; hsp=ifft2(ifftshift(F)).real\nthe threshold is fixed at 1, a 2\u00d72 box around DC", "props": {"operates_on": "UNet features", "params": "b1=1.1,b2=1.2,s1=0.9,s2=0.2"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_freelunch.py:8", "symbol": "def Fourier_filter"}, {"where": "ComfyUI/comfy_extras/nodes_freelunch.py:17", "symbol": "threshold"}, {"where": "ComfyUI/comfy_extras/nodes_freelunch.py:54", "symbol": "scale[0]"}, {"where": "ComfyUI/comfy_extras/nodes_freelunch.py:57", "symbol": "threshold=1"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["FreeU"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "FreeU"}, "family_fit": [{"family": "UNet models", "why": "reads unet_config model_channels; set_model_output_block_patch", "label": "from code", "source": "ComfyUI/comfy_extras/nodes_freelunch.py:47"}], "claims": [{"text": "Header credits ChenyangSi/FreeU under MIT", "label": "from code", "source": "ComfyUI/comfy_extras/nodes_freelunch.py:1"}], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}