{"id": "anima-adaptive-divergence", "name": "Anima adaptive CFG by divergence", "family": "guidance", "subfamily": "adaptive scale", "plain": "Sets the CFG scale each step from how far apart cond and uncond are: larger gap, lower scale, then clamps it. The gap is measured over the batch as a single number, so one scale applies to the whole batch.", "math": "d=mean over batch \u2016c\u2212u\u2016\u2082. s=base\u00b7(target/d)^a, clamped to [min,max]; if d<1e-8, s=base. x=u+s(c\u2212u).\nAdvanced node: s=schedule(progress)\u00b7(target/d)^a, floored at 1.", "props": {"hook": "cfg_function", "extra_model_calls": 0, "params": "cfg_base=5,min_cfg=2,max_cfg=15,adaptation_strength=.5,target_divergence=1"}, "evidence": [{"where": "DanrisiUA__ComfyUI-AnimaDynamicCFG/nodes.py:118", "symbol": "adaptive_cfg_function"}, {"where": "DanrisiUA__ComfyUI-AnimaDynamicCFG/nodes.py:22", "symbol": "_interpolate_cfg"}], "providers": [{"pack": "DanrisiUA__ComfyUI-AnimaDynamicCFG", "author": "DanrisiUA", "licence": "", "kind": "original", "nodes": ["AnimaAdaptiveCFG", "AnimaCFGScheduleAdvanced"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": [], "verdicts": [], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}