{"name": "music_roti_ace_edit_api.json", "format": "api", "fills": ["bpm", "extend", "key", "lyrics", "repaint_end", "repaint_start", "seconds", "seed", "source", "style"], "graph": {"1": {"class_type": "UNETLoader", "inputs": {"unet_name": "acestep_v1.5_turbo.safetensors", "weight_dtype": "default"}}, "2": {"class_type": "DualCLIPLoader", "inputs": {"clip_name1": "qwen_0.6b_ace15.safetensors", "clip_name2": "qwen_1.7b_ace15.safetensors", "type": "ace", "device": "default"}}, "3": {"class_type": "VAELoader", "inputs": {"vae_name": "ace_1.5_vae.safetensors"}}, "4": {"class_type": "LoadAudio", "inputs": {"audio": "${source}"}}, "5": {"class_type": "VAEEncodeAudio", "inputs": {"audio": ["4", 0], "vae": ["3", 0]}}, "6": {"class_type": "ACEStep15TaskTextEncode", "inputs": {"clip": ["2", 0], "text": "${style}", "task_type": "repaint", "track_name": "None", "lyrics": "${lyrics}", "bpm": "${bpm}", "duration": "${seconds}", "keyscale": "${key}", "timesignature": "4", "language": "en", "seed": "${seed}", "cfg_scale": 2.0, "temperature": 0.85, "top_p": 0.9, "top_k": 0, "min_p": 0.0}}, "7": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["6", 0]}}, "8": {"class_type": "ACEStep15NativeEditGuider", "inputs": {"model": ["10", 0], "positive": ["6", 0], "negative": ["7", 0], "source_latents": ["5", 0], "cfg": 1.0, "extend_left_seconds": 0.0, "extend_right_seconds": "${extend}", "repaint_start_seconds": "${repaint_start}", "repaint_end_seconds": "${repaint_end}"}}, "10": {"class_type": "ModelSamplingACEStep", "inputs": {"model": ["1", 0], "shift": 3.0}}, "11": {"class_type": "BasicScheduler", "inputs": {"model": ["10", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0}}, "12": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}}, "13": {"class_type": "RandomNoise", "inputs": {"noise_seed": "${seed}"}}, "14": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["13", 0], "guider": ["8", 0], "sampler": ["12", 0], "sigmas": ["11", 0], "latent_image": ["8", 1]}}, "15": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["14", 1], "vae": ["3", 0]}}, "16": {"class_type": "SaveAudioAdvanced", "inputs": {"audio": ["15", 0], "filename_prefix": "music/music_roti_edit", "format": "flac"}}}}