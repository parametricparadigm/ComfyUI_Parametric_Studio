{"id": "core-lms", "name": "LMS (linear multistep)", "family": "sampler", "subfamily": "multistep ODE", "plain": "Reuses slopes from previous steps instead of extra model calls: one call per step, up to fourth order by default. Coefficients are computed by numerically integrating Lagrange polynomials over the actual \u03c3 spacing. Deterministic.", "math": "Symbols: x current latent; \u03c3=sigmas[i]; \u03c3'=sigmas[i+1]; D=denoised (x0 prediction after CFG); U=uncond_denoised; d=(x\u2212D)/\u03c3. \ncur_order=min(i+1,order), order default 4. c_j=\u222b_{\u03c3}^{\u03c3'} \u220f_{k\u2260j}(\u03c4\u2212\u03c3_{i\u2212k})/(\u03c3_{i\u2212j}\u2212\u03c3_{i\u2212k}) d\u03c4 via scipy quad, epsrel 1e-4.\nx'=x+\u03a3_j c_j\u00b7d_{i\u2212j}.", "props": {"order": "up to 4 (ramps from 1)", "stages": "1", "stochastic": "deterministic", "multistep": true, "prediction_space": "\u03c3 (Karras ODE slopes)", "final_sigma0": "Explicit: \u03c3'=0 returns D.", "flow_const": "No branch; slopes d are used as in Euler."}, "evidence": [{"where": "ComfyUI/comfy/k_diffusion/sampling.py:488", "symbol": "sample_lms"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:406", "symbol": "linear_multistep_coeff"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:416", "symbol": "integrate.quad"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:501", "symbol": "sigmas[i + 1] == 0"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:507", "symbol": "coeffs"}, {"where": "ComfyUI/comfy_extras/nodes_custom_sampler.py:549", "symbol": "lms"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["KSampler", "KSamplerAdvanced", "KSamplerSelect", "SamplerLMS"], "note": "SamplerLMS exposes order 1 to 100, default 4.", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"sampler_name": "lms", "node": "SamplerLMS"}, "family_fit": [], "claims": [], "label": "fro