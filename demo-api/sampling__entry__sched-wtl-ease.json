{"id": "sched-wtl-ease", "name": "Dual Ease Cosine and Power Ease", "family": "scheduler", "subfamily": "curve-simple", "plain": "Easing curves in plain sigma. Dual ease raises a cosine to a power that drifts across the run. Power ease is a simple power of the ramp. Both enforce a small minimum gap.", "math": "Dual: \u03c1(x)=\u03c1s+(\u03c1e\u2212\u03c1s)x; \u03c3=\u03c3max\u2212(\u03c3max\u2212\u03c3min)(1\u2212((1+cos \u03c0x)/2)^\u03c1).\nPower: \u03c3=\u03c3max\u2212(\u03c3max\u2212\u03c3min)t^power.\nBoth: \u03c3_i \u2264 \u03c3_{i\u22121}\u22121e-4, then 0.", "props": {"shape": "eased in \u03c3", "params": "rho_start, rho_end / power; sigma range or model", "needs_model_sampling": false}, "evidence": [{"where": "Scorpiosis0__ComfyUI-WtlNodes/sigma/dual_ease_cosine_scheduler.py:48", "symbol": "get_sigmas"}, {"where": "Scorpiosis0__ComfyUI-WtlNodes/sigma/power_ease_scheduler.py:42", "symbol": "get_sigmas"}], "providers": [{"pack": "Scorpiosis0__ComfyUI-WtlNodes", "author": "Scorpiosis0", "licence": "Apache-2.0", "kind": "original", "nodes": ["DualEaseCosineSchedulerC", "PowerEaseSchedulerC"], "note": "", "verdict": "TRY", "risks": ["paid or partner API"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["paid or partner API"], "flagged_providers": 1, "licences": ["Apache-2.0"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}