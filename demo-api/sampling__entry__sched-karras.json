{"id": "sched-karras", "name": "karras", "family": "scheduler", "subfamily": "core-analytic", "plain": "The EDM schedule: interpolate linearly in \u03c3^(1/\u03c1) between the top and bottom sigma, so steps bunch up at low noise as \u03c1 rises. Only sigma_min and sigma_max are read from the model, so sigmas are off-table values. Available both as a scheduler name and as a standalone node with typed-in range.", "math": "ramp r_i = linspace(0,1,n).\n\u03c3_i = (\u03c3max^(1/\u03c1) + r_i\u00b7(\u03c3min^(1/\u03c1) \u2212 \u03c3max^(1/\u03c1)))^\u03c1, then 0. \u03c1=7 default.", "props": {"shape": "uniform in \u03c3^(1/\u03c1)", "params": "rho=7 (node sigma_max=14.614642, sigma_min=0.0291675)", "needs_model_sampling": false}, "evidence": [{"where": "ComfyUI/comfy/k_diffusion/sampling.py:23", "symbol": "get_sigmas_karras"}, {"where": "ComfyUI/comfy/samplers.py:1369", "symbol": "get_sigmas_karras"}, {"where": "ComfyUI/comfy_extras/nodes_custom_sampler.py:47", "symbol": "KarrasScheduler"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["KSampler", "BasicScheduler", "KarrasScheduler"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"scheduler": "karras", "node": "KarrasScheduler"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": true, "rendered_ids": ["flow-euler-karras", "scheduler-karras"], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}