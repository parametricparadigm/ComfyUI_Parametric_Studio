{"id": "sched-manual-expr", "name": "Manual scheduler (expression)", "family": "scheduler", "subfamily": "custom-editor", "plain": "Takes a typed formula and evaluates it per step using asteval. Variables include sigmax, sigmin, phi, position y and x, normalised descending Fibonacci f, step j and count s.", "math": "y=j/(s\u22121), x=1\u2212y, f=fib_normalised_desc[j]. \u03c3_j = your expression, then 0.\nDefault: ((1\u2212cos(2\u03c0(1\u2212\u221ay)/2))/2)\u00b7\u03c3max + ((1\u2212cos(2\u03c0\u00b7\u221ay/2))/2)\u00b7\u03c3min.", "props": {"shape": "user expression", "params": "custom_sigmas_manual_schedule, steps, sgm", "needs_model_sampling": true}, "evidence": [{"where": "sigmas_tools_and_the_golden_scheduler/sigmas_merge.py:364", "symbol": "manual_scheduler"}, {"where": "sigmas_tools_and_the_golden_scheduler/sigmas_merge.py:418", "symbol": "aeval"}, {"where": "sigmas_tools_and_the_golden_scheduler/sigmas_merge.py:52", "symbol": "fibonacci_normalized_descending"}], "providers": [{"pack": "sigmas_tools_and_the_golden_scheduler", "author": "", "licence": "none-found", "kind": "original", "nodes": ["manual_scheduler"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["none-found"], "verdicts": [], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}