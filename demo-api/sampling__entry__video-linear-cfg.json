{"id": "video-linear-cfg", "name": "Video Linear CFG Guidance", "family": "guidance", "subfamily": "frame-schedule", "plain": "Gives each batch element (video frame) its own cfg: lowest for the first frame, full for the last. Made for frame-as-batch video models. It has no effect in a single-element batch other than using min_cfg.", "math": "s_i = linspace(s_min, s, B)[i], B = batch size\nf = u + s_i\u00b7(c \u2212 u)\nIn a batch of 1, torch linspace gives s_min, so the node's cfg is ignored (inference from linspace behaviour).", "props": {"hook": "cfg_function", "extra_model_calls": 0, "params": "min_cfg=1.0"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_video_model.py:59", "symbol": "class VideoLinearCFGGuidance"}, {"where": "ComfyUI/comfy_extras/nodes_video_model.py:76", "symbol": "scale = torch.linspace(min_cfg, cond_scale"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["VideoLinearCFGGuidance"], "note": "", "verdict": "", "risks": [], "res4lyf": false}, {"pack": "17Retoucher__ComfyUI_Fooocus", "author": "17Retoucher", "licence": "none-found", "kind": "copy", "nodes": [], "note": "ldm_patched, not diffed", "verdict": "SKIP", "risks": ["installs software at runtime", "runs decoded or dynamic code", "paid or partner API", "patches torch or ComfyUI globally", "downloads models"], "res4lyf": false}], "providers_n": 2, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "VideoLinearCFGGuidance"}, "family_fit": [{"family": "video as batch", "why": "Uses cond.shape[0] and reshapes to 4D", "label": "from code", "source": "ComfyUI/comfy_extras/nodes_video_model.py:76"}], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["downloads models", "installs software at runtime", "paid or partner API", "patches torch or ComfyUI globally", "runs decoded or dynamic code"], "flagged_providers": 1, "licences": ["GPL-3.0", "none