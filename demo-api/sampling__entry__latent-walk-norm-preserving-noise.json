{"id": "latent-walk-norm-preserving-noise", "name": "LatentWalk norm-restored noise blending", "family": "noise", "subfamily": "interpolation", "plain": "Blends two NOISE objects by addition and then rescales the result to the norm a single noise would have. This avoids the shrinking that plain weighted addition gives, which the code comment says breaks sampling. A separate random walk adds norm-fixed steps with momentum.", "math": "blend = a\u00b7f_a + b\u00b7f_b; out = blend\u00b7\u2016\u03b5_ref\u2016/\u2016blend\u2016.\nRandom walk: step = n\u00b7\u2016start\u2016\u00b7dist/\u2016n\u2016; curr = (1\u2212m)\u00b7curr + m\u00b7(prev+step); renormalised to \u2016start\u2016.", "props": {"distribution": "Gaussian mix, whole-tensor norm restored", "spectrum": "unchanged", "when_applied": "initial"}, "evidence": [{"where": "rnbwdsh__ComfyUI-LatentWalk/helper.py:8", "symbol": "class NoiseWrapper"}, {"where": "rnbwdsh__ComfyUI-LatentWalk/helper.py:27", "symbol": "return unscaled * expected_norm / unscaled.norm()"}, {"where": "rnbwdsh__ComfyUI-LatentWalk/helper.py:41", "symbol": "def random_walk"}, {"where": "rnbwdsh__ComfyUI-LatentWalk/nodes.py:60", "symbol": "class LatentWalkNoise"}], "providers": [{"pack": "rnbwdsh__ComfyUI-LatentWalk", "author": "rnbwdsh", "licence": "GPL", "kind": "original", "nodes": ["LatentWalkNoise"], "note": "", "verdict": "TRY", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}