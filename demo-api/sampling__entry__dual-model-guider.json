{"id": "dual-model-guider", "name": "Dual Model CFG Guider", "family": "guidance", "subfamily": "core-guider", "plain": "Runs the positive pass on one model and the negative pass on another. It is the core way to do CFG where the two sides are different checkpoints, and loads the second model only when cfg is not 1. This is a mix of model pair, not autoguidance by name.", "math": "x\u0302 = cfg_function(cond=M_main(x; c), uncond=M_neg(x; n), s).\nNo uncond model is loaded when s\u22481 at start; if s\u22481 on a step, only cond is returned.", "props": {"hook": "guider", "extra_model_calls": "1 on each of 2 models", "params": "cfg=4.0; negative optional"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_custom_sampler.py:906", "symbol": "class Guider_DualModel"}, {"where": "ComfyUI/comfy_extras/nodes_custom_sampler.py:951", "symbol": "uncond = comfy.samplers.calc_cond_batch(self.uncond_inner"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["DualModelGuider"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "DualModelGuider"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}