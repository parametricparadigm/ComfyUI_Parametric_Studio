{"id": "h3-high-frequency-reentry", "name": "High-frequency noise re-entry on upscale (IAMCCS)", "family": "noise", "subfamily": "upscale", "plain": "After upscaling a video latent, adds only the part of fresh noise that the old resolution could not hold, scaled to the current sigma. Low frequencies, already decided by the earlier pass, are left alone. The noise generator runs on CPU, so seeds stay stable across memory modes.", "math": "fresh = seeded N(0,1) on CPU.\nlow = resize(resize(fresh, old size), new size); high = fresh \u2212 low.\nx \u2190 x + high\u00b7\u03c3\u00b7gain/max(RMS(high), 1e-6).", "props": {"distribution": "Gaussian, high-passed by resize", "spectrum": "high-pass above old resolution", "when_applied": "other"}, "evidence": [{"where": "IAMCCS__IAMCCS-nodes/iamccs_minimax_h3_progressive_spatial.py:145", "symbol": "def _seeded_noise_like"}, {"where": "IAMCCS__IAMCCS-nodes/iamccs_minimax_h3_progressive_spatial.py:154", "symbol": "def _high_frequency_reentry"}], "providers": [{"pack": "IAMCCS__IAMCCS-nodes", "author": "IAMCCS", "licence": "GPL", "kind": "original", "nodes": [], "note": "Call site not read", "verdict": "MAYBE", "risks": ["runs decoded or dynamic code", "paid or partner API", "patches torch or ComfyUI globally"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["paid or partner API", "patches torch or ComfyUI globally", "runs decoded or dynamic code"], "flagged_providers": 1, "licences": ["GPL"], "verdicts": ["MAYBE"], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}