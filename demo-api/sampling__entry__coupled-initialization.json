{"id": "coupled-initialization", "name": "Coupled Initialization (batch repulsion)", "family": "noise", "subfamily": "batch-correlation", "plain": "Makes the noises of a batch negatively correlated so a batch of images spreads out more. First item is unchanged. Each marginal stays standard Gaussian.", "math": "\u03c1 = \u2212s/(K\u22121), s = strength, K = batch.\nresult_i = \u03c1\u00b7\u03b5_0 + \u221a(1\u2212\u03c1)\u00b7(\u03b5_i \u2212 \u0113) + \u221a((1\u2212\u03c1)(1\u2212s))\u00b7\u0113, \u0113 = mean of \u03b5_1..K\u22121 (second term only for s<1).\n\u03b5_0 unchanged.", "props": {"distribution": "standard normal, correlated across batch", "spectrum": "white", "when_applied": "initial", "normalizes_variance": "yes, in exact arithmetic (per docstring and construction)"}, "evidence": [{"where": "jjia131__ComfyUI-CoupledInitialization/coupled_initialization/noise.py:38", "symbol": "couple_noise"}, {"where": "jjia131__ComfyUI-CoupledInitialization/coupled_initialization/noise.py:65", "symbol": "CoupledNoise"}], "providers": [{"pack": "jjia131__ComfyUI-CoupledInitialization", "author": "jjia131", "licence": "MIT", "kind": "original", "nodes": ["CoupledInitialization"], "note": "", "verdict": "TRY", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": true, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["MIT"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}