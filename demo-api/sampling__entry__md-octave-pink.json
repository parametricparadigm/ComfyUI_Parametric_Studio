{"id": "md-octave-pink", "name": "Octave-sum pink noise (MD_Nodes)", "family": "noise", "subfamily": "pyramid", "plain": "A 'pink' noise that uses no FFT: sums bilinearly upsampled lower resolution Gaussians with 1/(octave+1) weights. Closer to a pyramid than true 1/f.", "math": "num_oct=min(8,\u230alog\u2082min(h,w)\u230b). r=\u03a3_{k} (1/(k+1))\u00b7up(N(0,I)@h/2^k). r\u2190r/\u03a3w; r\u2190r/std(r).", "props": {"distribution": "Gaussian sum", "spectrum": "pyramid-like low boost", "when_applied": "initial", "normalizes_variance": "yes for pink; Auto-Norm is optional for blends"}, "evidence": [{"where": "MDMAchine__ComfyUI_MD_Nodes/core/custom_noise_core.py:170", "symbol": "_generate_pink_single_channel"}, {"where": "MDMAchine__ComfyUI_MD_Nodes/core/custom_noise_core.py:190", "symbol": "torch.std(result)"}, {"where": "MDMAchine__ComfyUI_MD_Nodes/noise/MD_CustomNoiseGenerator.py:114", "symbol": "MD_NoiseObject"}], "providers": [{"pack": "MDMAchine__ComfyUI_MD_Nodes", "author": "MDMAchine", "licence": "GPL", "kind": "original", "nodes": ["MD_CustomNoiseGenerator", "MD_MultiNoiseBlender"], "note": "", "verdict": "MAYBE", "risks": ["installs software at runtime", "runs decoded or dynamic code", "downloads models"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["downloads models", "installs software at runtime", "runs decoded or dynamic code"], "flagged_providers": 1, "licences": ["GPL"], "verdicts": ["MAYBE"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}