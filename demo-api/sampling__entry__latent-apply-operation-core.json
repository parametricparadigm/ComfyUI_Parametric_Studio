{"id": "latent-apply-operation-core", "name": "LatentApplyOperation and LatentApplyOperationCFG", "family": "latent", "subfamily": "operation-hook", "plain": "A LATENT_OPERATION is a function value on a wire. Applied directly it maps a latent. In the CFG form it hooks pre-CFG and acts only on the guidance delta (cond minus uncond), then adds uncond back, so an operation like sharpen or tonemap affects guidance rather than the whole prediction.", "math": "pre_cfg: if \u03c3 outside [\u03c3_end, \u03c3_start] skip\nif two outputs: cond \u2190 op(cond \u2212 uncond) + uncond\nelse cond \u2190 op(cond)", "props": {"operates_on": "LATENT or denoised predictions", "params": "operation; start_percent=0, end_percent=1"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_latent.py:339", "symbol": "operation(latent=s1)"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:373", "symbol": "conds_out[0] - conds_out[1]"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:378", "symbol": "set_model_sampler_pre_cfg_function"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["LatentApplyOperation", "LatentApplyOperationCFG"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "LatentApplyOperationCFG"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}