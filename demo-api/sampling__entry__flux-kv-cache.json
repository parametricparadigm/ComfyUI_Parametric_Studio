{"id": "flux-kv-cache", "name": "Flux KV Cache (reference tokens)", "family": "patch", "subfamily": "attention-kv", "plain": "Caches reference image K and V from the first pass so later steps skip those tokens in the input. Saves work for edit models whose reference image doesn't change, on the assumption the reference's features are close to fixed.", "math": "First call: store K,V last ref_tokens per key. Later: inputs['img'] drops last ref tokens; attn1 q,k,v gets cached K,V concatenated: k=cat(k,K), v=cat(v,V). Ref timestep forced by default_ref_method='index_timestep_zero'.", "props": {"hook": "set_model_attn1_patch + set_model_post_input_patch + add_object_patch(default_ref_method)", "architectures": "Flux family with reference images"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_flux.py:255", "symbol": "torch.cat"}, {"where": "ComfyUI/comfy_extras/nodes_flux.py:257", "symbol": "cache"}, {"where": "ComfyUI/comfy_extras/nodes_flux.py:265", "symbol": "FluxKVCache"}, {"where": "ComfyUI/comfy_extras/nodes_flux.py:298", "symbol": "add_object_patch"}, {"where": "YarvixPA__ComfyUI-YarvixPA/nodes/Flux/KV Cache/flux_kv_cache_gguf.py:121", "symbol": "set_model_attn1_patch"}], "providers": [{"pack": "YarvixPA__ComfyUI-YarvixPA", "author": "YarvixPA", "licence": "Apache-2.0", "kind": "variant", "nodes": [], "note": "GGUF path", "verdict": "TRY", "risks": ["downloads models"], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "FluxKVCache"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["downloads models"], "flagged_providers": 1, "licences": ["Apache-2.0"], "verdicts": ["TRY"], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}