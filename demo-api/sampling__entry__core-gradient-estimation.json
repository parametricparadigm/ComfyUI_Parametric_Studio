{"id": "core-gradient-estimation", "name": "Gradient Estimation", "family": "sampler", "subfamily": "multistep ODE", "plain": "Euler plus a correction from the change in slope between steps, scaled by \u03b3=2 by default. One call per step, deterministic. With \u03b3=2 the correction makes the step use 2d\u2212d_old from step 2.", "math": "Symbols: x current latent; \u03c3=sigmas[i]; \u03c3'=sigmas[i+1]; D=denoised (x0 prediction after CFG); U=uncond_denoised; d=(x\u2212D)/\u03c3. \nx_e=x+d\u00b7dt, dt=\u03c3'\u2212\u03c3. From i\u22651: x'=x_e+(\u03b3\u22121)(d\u2212d_old)dt, \u03b3=2.", "props": {"order": "nominal 2 from step 2 (\u03b3 dependent)", "stages": "1", "stochastic": "deterministic", "multistep": true, "prediction_space": "\u03c3 (Karras ODE slopes)", "final_sigma0": "Explicit: \u03c3'=0 returns D.", "flow_const": "No branch; slopes used as in Euler."}, "evidence": [{"where": "ComfyUI/comfy/k_diffusion/sampling.py:1544", "symbol": "sample_gradient_estimation"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:1569", "symbol": "sigmas[i + 1] == 0"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:1581", "symbol": "d_bar"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:1582", "symbol": "d_bar"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["KSampler", "KSamplerAdvanced", "KSamplerSelect"], "note": "", "verdict": "", "risks": [], "res4lyf": false}, {"pack": "pamparamm__ComfyUI-ppm", "author": "pamparamm", "licence": "AGPL-3.0", "kind": "original", "verdict": "", "risks": [], "res4lyf": false, "nodes": ["SamplerGradientEstimation"], "names": [], "note": "Exposes core sample_gradient_estimation's ge_gamma (2.0 to 5.0) as a node input."}], "providers_n": 2, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"sampler_name": "gradient_estimation", "node": "KSamplerSelect"}, "family_fit": [], "claims": [{"text": "Docstring cites openreview o2ND9v0CeK", "label": "from