{"id": "fft-highfreq-enhancer-lrzjason", "name": "Soft-gated high frequency enhancer", "family": "latent", "subfamily": "frequency", "plain": "Separates low frequency with a Gaussian in shifted FFT space, then boosts high frequency only where its smoothed magnitude clears a threshold through a sigmoid. Keeps detail while avoiding noise amplification. A companion runs this between sampling steps.", "math": "G=exp(\u22122\u03c0\u00b2\u03c3\u00b2D\u00b2), D on \u22120.5..0.5 grids; low=real(ifft2(ifftshift(fftshift(F)\u00b7G)))\nh=x\u2212low; m=\u03c3((|blur(h)|\u2212\u03c4)\u00b7hard)\nout=low+h\u00b7m\u00b7k", "props": {"operates_on": "LATENT 4D, squeezed 5D with one frame", "params": "high_freq_mult=1.15, sigma=2.0, denoise_threshold=.05, mask_hardness=2, hf_pre_blur_sigma=.5"}, "evidence": [{"where": "lrzjason__Comfyui-LatentUtils/nodes.py:33", "symbol": "gaussian"}, {"where": "lrzjason__Comfyui-LatentUtils/nodes.py:101", "symbol": "torch.sigmoid"}, {"where": "lrzjason__Comfyui-LatentUtils/nodes.py:104", "symbol": "high_freq_mult"}], "providers": [{"pack": "lrzjason__Comfyui-LatentUtils", "author": "lrzjason", "licence": "Apache-2.0", "kind": "original", "nodes": ["LatentFrequencyEnhancer_lrzjason", "HFEPostProcessor"], "note": "", "verdict": "TRY", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["Apache-2.0"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}