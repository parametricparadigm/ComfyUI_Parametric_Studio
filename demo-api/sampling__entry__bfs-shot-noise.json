{"id": "bfs-shot-noise", "name": "BFS shot-coherent noise", "family": "noise", "subfamily": "video-coherent", "plain": "Video start noise with several shaping options: replace coarse-block averages from a shot seed so shots match in composition, tilt the spectrum over space and time, and add pyramid. Uses careful unit-variance formulas throughout.", "math": "replace_coarse: each (time block, y, x) cell mean is replaced by a shot-seed draw, then rescaled to unit noise.\ntilt_spectrum: power \u00d7|f|^(\u2212\u03b1) over T,h,w; then zero mean, unit std.\nmix: \u221a(1\u2212w\u00b2)\u00b7x + w\u00b7signal.", "props": {"distribution": "Gaussian or chosen distribution, normalized", "spectrum": "3D power law optional", "when_applied": "initial", "normalizes_variance": "yes, per channel"}, "evidence": [{"where": "alisson-anjos__ComfyUI-BFSNodes/bfs_shot_noise.py:52", "symbol": "replace_coarse"}, {"where": "alisson-anjos__ComfyUI-BFSNodes/bfs_shot_noise.py:94", "symbol": "tilt_spectrum"}, {"where": "alisson-anjos__ComfyUI-BFSNodes/bfs_shot_noise.py:107", "symbol": "add_pyramid"}, {"where": "alisson-anjos__ComfyUI-BFSNodes/bfs_shot_noise.py:123", "symbol": "def mix"}, {"where": "alisson-anjos__ComfyUI-BFSNodes/bfs_shot_noise.py:174", "symbol": "BFSShotNoise"}], "providers": [{"pack": "alisson-anjos__ComfyUI-BFSNodes", "author": "alisson-anjos", "licence": "GPL", "kind": "original", "nodes": ["BFSShotNoise"], "note": "", "verdict": "TRY", "risks": ["installs software at runtime", "paid or partner API", "downloads models"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["downloads models", "installs software at runtime", "paid or partner API"], "flagged_providers": 1, "licences": ["GPL"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}