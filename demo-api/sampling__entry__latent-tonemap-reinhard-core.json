{"id": "latent-tonemap-reinhard-core", "name": "LatentOperationTonemapReinhard", "family": "latent", "subfamily": "tonemap", "plain": "Compresses overly large latent vector magnitudes while keeping directions. The white point comes from per-sample stats of the magnitude map. It can go through LatentApplyOperationCFG to act on guidance. The formula always compresses, including at low values, since it is plain Reinhard with no knee.", "math": "m=\u2016x\u2016\u2082 over channels (+1e\u221210), u=x/m\n\u03bc,s = mean, std of m per sample\ntop=(5s+\u03bc)\u00b7multiplier\nm\u2032 = (m/top)/((m/top)+1)\u00b7top\nout = u\u00b7m\u2032", "props": {"operates_on": "LATENT_OPERATION", "params": "multiplier=1.0"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_latent.py:433", "symbol": "latent_vector_magnitude"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:440", "symbol": "top = "}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:444", "symbol": "new_magnitude"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["LatentOperationTonemapReinhard"], "note": "", "verdict": "", "risks": [], "res4lyf": false}, {"pack": "ComfyUI-ppm", "author": "pamparamm", "licence": "AGPL-3.0", "kind": "variant", "nodes": ["LatentOperationTonemapLuminance"], "note": "see latent-tonemap-luminance-ppm", "verdict": "TRY", "risks": ["patches torch or ComfyUI globally"], "res4lyf": false}], "providers_n": 2, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "LatentOperationTonemapReinhard"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["patches torch or ComfyUI globally"], "flagged_providers": 1, "licences": ["AGPL-3.0", "GPL-3.0"], "verdicts": ["TRY"], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}