{"name": "A picture graph with five faults", "text": "{\n \"1\": {\n  \"class_type\": \"CheckpointLoaderSimple\",\n  \"inputs\": {\n   \"ckpt_name\": \"sd_xl_base_1.0.safetensors\"\n  }\n },\n \"2\": {\n  \"class_type\": \"CLIPTextEncode\",\n  \"inputs\": {\n   \"text\": \"a lighthouse at dawn\",\n   \"clip\": [\n    \"1\",\n    1\n   ]\n  }\n },\n \"3\": {\n  \"class_type\": \"CLIPTextEncode\",\n  \"inputs\": {\n   \"text\": \"\",\n   \"clip\": [\n    \"1\",\n    9\n   ]\n  }\n },\n \"4\": {\n  \"class_type\": \"EmptyLatentImage\",\n  \"inputs\": {\n   \"width\": \"1024\",\n   \"height\": 1024,\n   \"batch_size\": 1\n  }\n },\n \"5\": {\n  \"class_type\": \"KSampler\",\n  \"inputs\": {\n   \"model\": [\n    \"1\",\n    0\n   ],\n   \"positive\": [\n    \"2\",\n    0\n   ],\n   \"negative\": [\n    \"3\",\n    0\n   ],\n   \"latent_image\": [\n    \"4\",\n    0\n   ],\n   \"seed\": 7,\n   \"steps\": 20,\n   \"cfg\": 7.0,\n   \"sampler_name\": \"eular\",\n   \"scheduler\": \"normal\",\n   \"denoise\": 1.5\n  }\n },\n \"6\": {\n  \"class_type\": \"VAEDecode\",\n  \"inputs\": {\n   \"samples\": [\n    \"5\",\n    0\n   ],\n   \"vae\": [\n    \"1\",\n    2\n   ]\n  }\n }\n}"}