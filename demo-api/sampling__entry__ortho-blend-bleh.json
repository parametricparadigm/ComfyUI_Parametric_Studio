{"id": "ortho-blend-bleh", "name": "Orthogonal blend", "family": "latent", "subfamily": "blend", "plain": "Removes from b the part parallel to a, then applies the blend, so t adds only new direction rather than scaling a. Options rescale to a chosen target, or dynamically fall back to the plain result when the orthogonal part would need too much rescale. This relates to perpendicular guidance methods.", "math": "proj=(a\u00b7b/a\u00b7a)\u00b7a; b\u22a5 = b\u00b7ortho_scale + proj\u00b7proj_scale (default \u22121)\nif rescale_limit: b\u22a5 *= clamp(\u2016b\u2016/\u2016b\u22a5\u2016, \u00b1limit)\ndefault blend: a + t\u00b7b\u22a5\ndyn mode: lerp(plain, ortho, factor) with factor from the rescale ratio", "props": {"operates_on": "LATENT, guidance tensors", "params": "proj_scale=-1, ortho_scale=1, rescale_limit=0, dyn_ortho_mode=False"}, "evidence": [{"where": "blepping__ComfyUI-bleh/py/latent_utils.py:255", "symbol": "def ortho_projection"}, {"where": "blepping__ComfyUI-bleh/py/latent_utils.py:1067", "symbol": "b_ortho"}, {"where": "blepping__ComfyUI-bleh/py/latent_utils.py:1080", "symbol": "add_(a)"}, {"where": "blepping__ComfyUI-bleh/py/latent_utils.py:3366", "symbol": "ortho_blend"}], "providers": [{"pack": "ComfyUI-bleh", "author": "blepping", "licence": "Apache-2.0", "kind": "original", "nodes": ["BlehLatentBlend"], "note": "", "verdict": "TRY", "risks": ["runs decoded or dynamic code", "paid or partner API", "patches torch or ComfyUI globally"], "res4lyf": false, "blepping": true}], "providers_n": 1, "in_core": false, "live": true, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["paid or partner API", "patches torch or ComfyUI globally", "runs decoded or dynamic code"], "flagged_providers": 1, "licences": ["Apache-2.0"], "verdicts": ["TRY"], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}