{"id": "kohya-deep-shrink-core", "name": "PatchModelAddDownscale (Kohya Deep Shrink, hires-fix alternative)", "family": "latent", "subfamily": "hires", "plain": "A patch that does hires-fix style structure control inside the UNet. Early in sampling it shrinks the hidden feature at one block by a factor, and upscales on the way out to match the skip. Works at model feature level, no second pass.", "math": "if \u03c3_end \u2264 \u03c3 \u2264 \u03c3_start at block n: h = resize(h, 1/factor, downscale_method)\noutput: if h,hsp heights differ: h = resize(h, hsp size, upscale_method)", "props": {"operates_on": "UNet features", "params": "block_number=3, downscale_factor=2, start_percent=0, end_percent=0.35, downscale_after_skip=True"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_model_downscale.py:37", "symbol": "common_upscale"}, {"where": "ComfyUI/comfy_extras/nodes_model_downscale.py:42", "symbol": "common_upscale"}, {"where": "ComfyUI/comfy_extras/nodes_model_downscale.py:46", "symbol": "downscale_after_skip"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["PatchModelAddDownscale"], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "PatchModelAddDownscale"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}