{"name": "oneclick_angles_api.json", "format": "api", "fills": ["angle_1", "angle_2", "angle_3", "angle_4", "image", "seed", "strength"], "graph": {"unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_edit_2511_fp8mixed.safetensors", "weight_dtype": "default"}}, "fast": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["unet", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}}, "look": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["fast", 0], "lora_name": "qwen-image-edit-2511-multiple-angles-lora.safetensors", "strength_model": "${strength}"}}, "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["look", 0], "shift": 3.1}}, "norm": {"class_type": "CFGNorm", "inputs": {"model": ["shift", 0], "strength": 1, "pre_cfg": false}}, "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}}, "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}}, "src": {"class_type": "LoadImage", "inputs": {"image": "${image}"}}, "fit": {"class_type": "FluxKontextImageScale", "inputs": {"image": ["src", 0]}}, "lat": {"class_type": "VAEEncode", "inputs": {"pixels": ["fit", 0], "vae": ["vae", 0]}}, "neg": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["fit", 0], "prompt": ""}}, "negref": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["neg", 0], "reference_latents_method": "index_timestep_zero"}}, "pos1": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["fit", 0], "prompt": "<sks> ${angle_1}"}}, "ref1": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["pos1", 0], "reference_latents_method": "index_timestep_zero"}}, "ks1": {"class_type": "KSampler", "inputs": {"model": ["norm", 0], "positive": ["ref1", 0], "negative": ["negref", 0], "latent_image": ["lat", 0], "seed": "${seed}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}}, "dec1": {"class_type": "VAEDecode", "inputs": {"samples": ["ks1", 0], "vae": ["vae", 0]}}, "save1": {"class_type": "SaveImage", "inputs": {"images": ["dec1", 0], "filename_prefix": "oneclick_angles/angle1"}}, "pos2": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["fit", 0], "prompt": "<sks> ${angle_2}"}}, "ref2": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["pos2", 0], "reference_latents_method": "index_timestep_zero"}}, "ks2": {"class_type": "KSampler", "inputs": {"model": ["norm", 0], "positive": ["ref2", 0], "negative": ["negref", 0], "latent_image": ["lat", 0], "seed": "${seed}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}}, "dec2": {"class_type": "VAEDecode", "inputs": {"samples": ["ks2", 0], "vae": ["vae", 0]}}, "save2": {"class_type": "SaveImage", "inputs": {"images": ["dec2", 0], "filename_prefix": "oneclick_angles/angle2"}}, "pos3": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["fit", 0], "prompt": "<sks> ${angle_3}"}}, "ref3": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["pos3", 0], "reference_latents_method": "index_timestep_zero"}}, "ks3": {"class_type": "KSampler", "inputs": {"model": ["norm", 0], "positive": ["ref3", 0], "negative": ["negref", 0], "latent_image": ["lat", 0], "seed": "${seed}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}}, "dec3": {"class_type": "VAEDecode", "inputs": {"samples": ["ks3", 0], "vae": ["vae", 0]}}, "save3": {"class_type": "SaveImage", "inputs": {"images": ["dec3", 0], "filename_prefix": "oneclick_angles/angle3"}}, "pos4": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["fit", 0], "prompt": "<sks> ${angle_4}"}}, "ref4": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["pos4", 0], "reference_latents_method": "index_timestep_zero"}}, "ks4": {"class_type": "KSampler", "inputs": {"model": ["norm", 0], "positive": ["ref4", 0], "negative": ["negref", 0], "latent_image": ["lat", 0], "seed": "${seed}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}}, "dec4": {"class_type": "VAEDecode", "inputs": {"samples": ["ks4", 0], "vae": ["vae", 0]}}, "save4": {"class_type": "SaveImage", "inputs": {"images": ["dec4", 0], "filename_prefix": "oneclick_angles/angle4"}}}}