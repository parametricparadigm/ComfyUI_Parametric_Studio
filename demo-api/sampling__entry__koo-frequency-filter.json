{"id": "koo-frequency-filter", "name": "KoO pink, blue, high and low frequency noise", "family": "noise", "subfamily": "colored-fft", "plain": "Simple spectrum filter. Pink is one over root radius, blue is root radius, with a clamped floor for DC. Also blur-based high and low frequency variants. Values rescaled by filter mean, not variance.", "math": "r=max(\u221a(fx\u00b2+fy\u00b2),1/max(h,w)). pink s=1/\u221ar, blue s=\u221ar; s\u2190s/mean(s). out=irfftn(rfftn(\u03b5)\u00b7s).\nhigh_frequency: \u03b5\u2212blur(\u03b5,1.5). low_frequency: blur(\u03b5,4).", "props": {"distribution": "filtered Gaussian or uniform", "spectrum": "pink/blue proper direction", "when_applied": "initial", "normalizes_variance": "no: filter mean only, so std \u2260 1, and low_frequency has much lower variance"}, "evidence": [{"where": "kooailab__koo-nodes-pack/nodes/noise_lab/noise_utils.py:239", "symbol": "frequency_filter_noise"}, {"where": "kooailab__koo-nodes-pack/nodes/noise_lab/noise_utils.py:260", "symbol": "generate_noise"}, {"where": "kooailab__koo-nodes-pack/nodes/noise_lab/noise_utils.py:275", "symbol": "gaussian_blur_2d"}], "providers": [{"pack": "kooailab__koo-nodes-pack", "author": "kooailab", "licence": "other:LICENSE", "kind": "original", "nodes": ["KoOLatentNoiseInjector", "KoOFrequencyNoiseMixer", "KoOSpectralNoise"], "note": "", "verdict": "TRY", "risks": ["paid or partner API"], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["paid or partner API"], "flagged_providers": 1, "licences": ["other:LICENSE"], "verdicts": ["TRY"], "audit": null, "run_patch": "", "run_guider": "", "prefer_model": ""}