endered", "seconds": 4.2, "note": "", "sha256": "9b07a439883b8e3b", "baseline": false, "brightness": 95.8, "contrast": 65.0, "edge": 22.75, "diff_to_base": 21.38, "pack": "silveroxides__ComfyUI_SigmoidOffsetScheduler", "peak_gib": 11.45, "error": null, "pixels": "47de875733c6ce8e", "seen": "Same layout, a little softer, with fewer small objects.", "identical_to": [], "url": "sampling_lab/pack-scheduler-sigmoid_offset.jpg", "entry": "sched-sigmoid-offset"}], "seen": [{"text": "The ddim sampler name gives the same pixels as euler (same seed, same graph). Core maps the name to Euler; only the inpaint noise option differs.", "id": "", "where": "measured here, see Renders", "source": "renders"}, {"text": "CFGNorm at strength 1 with CFG 14 washed an SDXL render to pale grey on this seed, while Rescale and APG at the same CFG stayed usable.", "id": "", "where": "measured here, see Renders", "source": "renders"}, {"text": "The linear_quadratic schedule with dpmpp_2m smeared an SDXL render at 20 steps, with rainbow speckle. On this model its last non-zero sigma at 20 steps is 2.67, against 0.03 for karras, so the last step jumps a long way to zero.", "id": "", "where": "measured here, see Renders", "source": "renders"}, {"text": "ddim_uniform starts lower than the rest: sigma 11.03 at 20 steps on SD and SDXL, where the others start at 14.61. It rendered brighter, with a different layout.", "id": "", "where": "measured here, see Renders", "source": "renders"}, {"text": "Karras at 20 steps broke SD 3.5 Medium with Euler (brown and unfinished), while simple, beta and kl_optimal held together on the same seed.", "id": "", "where": "measured here, see Renders", "source": "renders"}], "bases": {"sampler": "sampler-euler", "scheduler": "scheduler-normal", "guidance": "guidance-cfg-7", "flow": "flow-euler-simple", "pack-sampler": "pack-sampler-euler", "pack-scheduler": "pack-scheduler-normal", "pack-guidance": "pack-guidance-cfg-14"}, "pack_lab": {"attempted": 6, "rendered": 0, "why": "The Pack Lab sandbox failed the control render too (VAEDecode: maximum recursion depth exceeded), so no non-core method is proven by render here."}, "packs": {"rendered": 14, "attempted": 14, "entries": 14, "date": "2026-11-03", "how": "On this machine's own ComfyUI with the packs installed, through the shared GPU gate, one at a time. Same seed, prompt and model as the core renders; each set re-rendered its core baseline first."}}