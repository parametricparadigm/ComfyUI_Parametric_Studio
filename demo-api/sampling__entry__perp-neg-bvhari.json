{"id": "perp-neg-bvhari", "name": "PerpNeg fork that projects positive onto negative (bvhari)", "family": "guidance", "subfamily": "perp-neg", "plain": "Early Perp-Neg node that removes from the positive its part along the negative. So it subtracts the projected positive, rather than a perpendicular negative. Name matches core but the geometry differs.", "math": "p = x\u0302_c\u2212x\u0302_\u2205, n = x\u0302_n\u2212x\u0302_\u2205\nP = (\u27e8p,n\u27e9/\u2016n\u2016\u00b2)\u00b7n\nx\u0302 = x\u0302_\u2205 + s\u00b7(p \u2212 w\u00b7P)", "props": {"hook": "cfg_function", "extra_model_calls": "1 extra empty pass", "params": "neg_scale=1.0"}, "evidence": [{"where": "bvhari__ComfyUI_PerpNeg/perpneg.py:104", "symbol": "perp = ((torch.mul(pos, neg).sum())/(torch.norm(neg)**2)) * neg"}], "providers": [{"pack": "bvhari__ComfyUI_PerpNeg", "author": "bvhari", "licence": "GPL", "kind": "original", "nodes": ["KSamplerPerpNeg", "ModelPerpNeg"], "note": "also a KSampler wrapper", "verdict": "SKIP", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": false, "live": false, "needs_pack": true, "core_ref": {}, "family_fit": [], "claims": [], "label": "from code", "surprise": "Variable named perp is actually the parallel projection of pos on neg: w=1 removes all overlap of the positive with the negative, unlike core.", "rendered": false, "rendered_ids": [], "risks": [], "flagged_providers": 0, "licences": ["GPL"], "verdicts": ["SKIP"], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}