{"name": "worldkit_body_photo_api.json", "format": "api", "fills": ["image"], "graph": {"img": {"class_type": "LoadImage", "inputs": {"image": "${image}"}}, "s3ck": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "SAM 3.1/sam3.1_multiplex_fp16.safetensors"}}, "s3txt": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["s3ck", 1], "text": "person"}}, "trk": {"class_type": "SAM3_VideoTrack", "inputs": {"images": ["img", 0], "model": ["s3ck", 0], "detection_threshold": 0.5, "max_objects": 4, "detect_interval": 1, "conditioning": ["s3txt", 0]}}, "mogem": {"class_type": "LoadMoGeModel", "inputs": {"model_name": "moge_2_vitl_normal_fp16.safetensors"}}, "moge": {"class_type": "MoGeInference", "inputs": {"moge_model": ["mogem", 0], "image": ["img", 0], "resolution_level": 9, "fov_x_degrees": 0.0, "batch_size": 4, "force_projection": true, "apply_mask": true, "refine_steps": 3}}, "fov": {"class_type": "MoGeGeometryToFOV", "inputs": {"moge_geometry": ["moge", 0], "axis": "vertical", "unit": "degrees"}}, "body": {"class_type": "SAM3DBody_Loader", "inputs": {"model_file": "sam_3d_body_dinov3_bf16.safetensors"}}, "pred": {"class_type": "SAM3DBody_Predict", "inputs": {"sam3d_body_model": ["body", 0], "image": ["img", 0], "run_hand_refinement": false, "fov": ["fov", 0], "batch_size": 64, "track_data": ["trk", 0]}}, "face": {"class_type": "SAM3DBody_FaceExpression", "inputs": {"sam3d_body_model": ["body", 0], "mhr_pose_data": ["pred", 0], "image": ["img", 0], "strength": 1.0, "mouth_strength": 1.0, "eye_strength": 2.0, "brow_strength": 2.0, "input_threshold": 0.02, "blendshape_smooth_window": 7}}, "glb": {"class_type": "BuildPoseFile", "inputs": {"pose_data": ["face", 0], "format": "glb", "format.mesh_style": "body_mesh", "format.mesh_style.bone_vis": "off", "format.mesh_style.shader": "default", "format.bone_smooth_window": 0, "sam3d_body_model": ["body", 0], "fps": 24.0, "camera_translation": "off", "track_index": -1}}, "rmesh": {"class_type": "SAM3DBody_Render", "inputs": {"pose_data": ["face", 0], "width": 0, "height": 0, "render_style": "mesh", "render_style.shader": "default", "render_style.opacity": 1.0, "render_style.person_palette_falloff": 0.6, "render_style.region": "full_body", "background": ["img", 0]}}, "rpose": {"class_type": "SAM3DBody_Render", "inputs": {"pose_data": ["face", 0], "width": 0, "height": 0, "render_style": "openpose_2d", "render_style.marker_radius_px": 4, "render_style.stick_width_px": 4, "render_style.limb_alpha": 0.6, "render_style.face_style": "disabled", "render_style.hand_style": "disabled", "render_style.person_palette_falloff": 0.6}}, "save_glb": {"class_type": "SaveGLB", "inputs": {"mesh": ["glb", 0], "filename_prefix": "worldkit/body"}}, "save_preview": {"class_type": "SaveImage", "inputs": {"images": ["rmesh", 0], "filename_prefix": "worldkit/body_preview"}}, "save_pose": {"class_type": "SaveImage", "inputs": {"images": ["rpose", 0], "filename_prefix": "worldkit/body_pose"}}}}