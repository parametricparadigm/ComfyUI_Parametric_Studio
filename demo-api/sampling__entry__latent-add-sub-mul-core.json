{"id": "latent-add-sub-mul-core", "name": "Latent add, subtract, multiply", "family": "latent", "subfamily": "arithmetic", "plain": "Plain element-wise arithmetic on latent tensors. Add and subtract first resize the second latent to the first with bilinear centre-crop and repeat it to the batch size. No variance handling, so adding two noise-like latents raises the variance and subtracting cancels content.", "math": "add: out = s1 + R(s2)\nsub: out = s1 \u2212 R(s2)\nmul: out = s1 \u00b7 multiplier\nR = common_upscale(bilinear, center) if shapes differ, then repeat_to_batch_size", "props": {"operates_on": "LATENT", "params": "multiplier=1.0 (\u221210..10)"}, "evidence": [{"where": "ComfyUI/comfy_extras/nodes_latent.py:43", "symbol": "s1 + s2"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:70", "symbol": "s1 - s2"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:94", "symbol": "s1 * multiplier"}, {"where": "ComfyUI/comfy_extras/nodes_latent.py:10", "symbol": "reshape_latent_to"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": ["LatentAdd", "LatentSubtract", "LatentMultiply"], "note": "", "verdict": "", "risks": [], "res4lyf": false}, {"pack": "mozhaa__ComfyUI-Latent-Transform", "author": "mozhaa", "licence": "none-found", "kind": "variant", "nodes": ["LTMultiply", "LTAdd"], "note": "names only, not opened", "verdict": "TRY", "risks": [], "res4lyf": false}, {"pack": "denfrost__Den_ComfyUI_Workflow", "author": "denfrost", "licence": "Apache-2.0", "kind": "variant", "nodes": ["Den_LatentAdd_AS"], "note": "names only, not opened", "verdict": "SKIP", "risks": ["runs decoded or dynamic code"], "res4lyf": false}], "providers_n": 3, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"node": "LatentAdd"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": false, "rendered_ids": [], "risks": ["runs decoded or dynamic code"], "flagged_providers": 1, "lic