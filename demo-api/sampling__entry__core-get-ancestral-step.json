{"id": "core-get-ancestral-step", "name": "get_ancestral_step (VE ancestral noise split)", "family": "noise", "subfamily": "ancestral", "plain": "Splits one step into a deterministic move down to sigma_down and a fresh noise addition sigma_up, so the combined variance lands exactly on the target sigma. eta scales how much of the step is stochastic.", "math": "\u03c3_up = min(\u03c3_to, \u03b7\u00b7\u221a(\u03c3_to\u00b2\u00b7(\u03c3_from\u00b2\u2212\u03c3_to\u00b2)/\u03c3_from\u00b2)).\n\u03c3_down = \u221a(\u03c3_to\u00b2\u2212\u03c3_up\u00b2). If \u03b7=0: (\u03c3_to,0).\nThen x \u2190 x + d\u00b7(\u03c3_down\u2212\u03c3) + \u03b5\u00b7s_noise\u00b7\u03c3_up.", "props": {"distribution": "from noise sampler", "spectrum": "from noise sampler", "when_applied": "per-step", "normalizes_variance": "variance-preserving by construction when s_noise=1"}, "evidence": [{"where": "ComfyUI/comfy/k_diffusion/sampling.py:68", "symbol": "get_ancestral_step"}, {"where": "ComfyUI/comfy/k_diffusion/sampling.py:216", "symbol": "sample_euler_ancestral"}], "providers": [{"pack": "core", "author": "Comfy Org and contributors", "licence": "GPL-3.0", "kind": "original", "nodes": [], "note": "", "verdict": "", "risks": [], "res4lyf": false}], "providers_n": 1, "in_core": true, "live": false, "needs_pack": false, "core_ref": {"sampler_name": "euler_ancestral", "node": "SamplerEulerAncestral"}, "family_fit": [], "claims": [], "label": "from code", "surprise": "", "rendered": true, "rendered_ids": ["sampler-euler_ancestral"], "risks": [], "flagged_providers": 0, "licences": ["GPL-3.0"], "verdicts": [], "audit": {"verdict": "correct", "fixed": false, "note": ""}, "run_patch": "", "run_guider": "", "prefer_model": ""}