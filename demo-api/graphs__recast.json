{"goal": "recast", "fills": ["frames", "height", "image", "prompt", "seed", "slice_seconds", "video", "width"], "graph": {"src": {"class_type": "LoadVideo", "inputs": {"file": "${video}"}}, "part": {"class_type": "Video Slice", "inputs": {"video": ["src", 0], "start_time": 0.0, "duration": "${slice_seconds}", "strict_duration": false}}, "comp": {"class_type": "GetVideoComponents", "inputs": {"video": ["part", 0]}}, "fps24": {"class_type": "PSN_FPSResampler", "inputs": {"image": ["comp", 0], "source_fps": ["comp", 2], "target_fps": 24.0, "mode": "nearest"}}, "trim": {"class_type": "ImageFromBatch", "inputs": {"image": ["fps24", 0], "batch_index": 0, "length": "${frames}"}}, "scale": {"class_type": "ImageScale", "inputs": {"image": ["trim", 0], "upscale_method": "lanczos", "width": "${width}", "height": "${height}", "crop": "center"}}, "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3/minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}}, "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen/qwen3-vl-32b/qwen3-vl-32b-minimax-h3-nvfp4-awq.safetensors", "type": "minimax", "device": "default"}}, "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}}, "avae": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}}, "free_te": {"class_type": "VRAM_Debug", "inputs": {"any_input": ["ref", 0], "empty_cache": true, "gc_collect": true, "unload_all_models": true}}, "noise": {"class_type": "RandomNoise", "inputs": {"noise_seed": "${seed}"}}, "dec": {"class_type": "VAEDecode", "inputs": {"samples": ["samp", 0], "vae": ["vae", 0]}}, "mk": {"class_type": "CreateVideo", "inputs": {"images": ["dec", 0], "audio": ["comp", 1], "fps": 24.0}}, "swap": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["unet", 0], "lora_name": "minimax_h3/h3_character_swap_pro4500_1000.safetensors", "strength_model": 1.0}}, "char": {"class_type": "LoadImage", "inputs": {"image": "${image}"}}, "ref": {"class_type": "MiniMaxH3ReferenceToVideo", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "audio_vae": ["avae", 0], "prompt": "${prompt}", "width": "${width}", "height": "${height}", "length": "${frames}", "ref_image_size": "match", "ref_images.ref_image_0": ["char", 0], "ref_videos.ref_video_0": ["scale", 0]}}, "guider": {"class_type": "BasicGuider", "inputs": {"model": ["swap", 0], "conditioning": ["free_te", 0]}}, "sched": {"class_type": "BasicScheduler", "inputs": {"model": ["swap", 0], "scheduler": "simple", "steps": 12, "denoise": 1.0}}, "ksel": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}}, "samp": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["ksel", 0], "sigmas": ["sched", 0], "latent_image": ["ref", 1]}}, "save": {"class_type": "SaveVideo", "inputs": {"video": ["mk", 0], "filename_prefix": "recast/recast", "format": "auto", "codec": "auto"}}}}