{
 "ck": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "flux1-schnell.safetensors",
   "weight_dtype": "default"
  }
 },
 "ck_clip": {
  "class_type": "DualCLIPLoader",
  "inputs": {
   "clip_name1": "clip_l.safetensors",
   "clip_name2": "t5xxl_fp16.safetensors",
   "type": "flux"
  }
 },
 "ck_vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ae.safetensors"
  }
 },
 "neg": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "low quality, blurry, jpeg artifacts",
   "clip": [
    "ck_clip",
    0
   ]
  }
 },
 "empty": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": 1024,
   "height": 1024,
   "batch_size": 1
  }
 },
 "pos_text": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "a red lighthouse on a rocky coast at dusk, waves, dramatic clouds, oil painting",
   "clip": [
    "ck_clip",
    0
   ]
  }
 },
 "sm": {
  "class_type": "StyleModelLoader",
  "inputs": {
   "style_model_name": "flux/flux1-redux-dev.safetensors"
  }
 },
 "cv": {
  "class_type": "CLIPVisionLoader",
  "inputs": {
   "clip_name": "SIG CLIP/SIGLIP 384/sigclip_vision_patch14_384.safetensors"
  }
 },
 "ref_img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "res4lyf_style_ref_flux.png"
  }
 },
 "vis": {
  "class_type": "CLIPVisionEncode",
  "inputs": {
   "clip_vision": [
    "cv",
    0
   ],
   "image": [
    "ref_img",
    0
   ],
   "crop": "center"
  }
 },
 "patched_style": {
  "class_type": "ReReduxPatcher",
  "inputs": {
   "style_model": [
    "sm",
    0
   ],
   "style_dtype": "float64",
   "enable": true
  }
 },
 "pos": {
  "class_type": "StyleModelApplyStyle",
  "inputs": {
   "conditioning": [
    "pos_text",
    0
   ],
   "style_model": [
    "patched_style",
    0
   ],
   "clip_vision_output": [
    "vis",
    0
   ],
   "strength": 1.0
  }
 },
 "s": {
  "class_type": "ClownsharKSampler_Beta",
  "inputs": {
   "eta": 0.5,
   "sampler_name": "multistep/res_2m",
   "scheduler": "beta57",
   "steps": 8,
   "steps_to_run": -1,
   "denoise": 1.0,
   "cfg": 1.0,
   "seed": 4242,
   "sampler_mode": "standard",
   "bongmath": true,
   "model": [
    "ck",
    0
   ],
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "latent_image": [
    "empty",
    0
   ]
  }
 },
 "dec": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "s",
    0
   ],
   "vae": [
    "ck_vae",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "dec",
    0
   ],
   "filename_prefix": "res4lyf_flux_redux_style"
  }
 }
}