{
 "src": {
  "class_type": "LoadVideo",
  "inputs": {
   "file": "${video}"
  }
 },
 "part": {
  "class_type": "Video Slice",
  "inputs": {
   "video": [
    "src",
    0
   ],
   "start_time": 0.0,
   "duration": "${slice_seconds}",
   "strict_duration": false
  }
 },
 "comp": {
  "class_type": "GetVideoComponents",
  "inputs": {
   "video": [
    "part",
    0
   ]
  }
 },
 "fps24": {
  "class_type": "PSN_FPSResampler",
  "inputs": {
   "image": [
    "comp",
    0
   ],
   "source_fps": [
    "comp",
    2
   ],
   "target_fps": 24.0,
   "mode": "nearest"
  }
 },
 "trim": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "fps24",
    0
   ],
   "batch_index": 0,
   "length": "${frames}"
  }
 },
 "scale": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "trim",
    0
   ],
   "upscale_method": "lanczos",
   "width": "${width}",
   "height": "${height}",
   "crop": "center"
  }
 },
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx 2.5/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "lora": {
  "class_type": "LTXICLoRALoaderModelOnly",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "lora_name": "${lora}",
   "strength_model": "${strength}"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
   "type": "ltxv",
   "device": "default"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx/ltx-2.5-video-vae-conv-bf16.safetensors"
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx/ltx-2.5-audio-vae-bf16.safetensors"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "text": "${prompt}"
  }
 },
 "neg": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "text": "${negative}"
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24.0
  }
 },
 "lat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": "${width}",
   "height": "${height}",
   "length": "${frames}",
   "batch_size": 1
  }
 },
 "guide": {
  "class_type": "LTXAddVideoICLoRAGuide",
  "inputs": {
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "vae": [
    "vae",
    0
   ],
   "latent": [
    "lat",
    0
   ],
   "image": [
    "scale",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0,
   "latent_downscale_factor": [
    "lora",
    1
   ],
   "crop": "disabled",
   "use_tiled_encode": false,
   "tile_size": 256,
   "tile_overlap": 64
  }
 },
 "guider": {
  "class_type": "CFGGuider",
  "inputs": {
   "model": [
    "lora",
    0
   ],
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "cfg": 1.0
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": "${seed}"
  }
 },
 "ksel": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler_ancestral"
  }
 },
 "sig": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
  }
 },
 "aud": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "audio_vae": [
    "avae",
    0
   ],
   "frames_number": "${frames}",
   "frame_rate": 24,
   "batch_size": 1
  }
 },
 "av": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "guide",
    2
   ],
   "audio_latent": [
    "aud",
    0
   ]
  }
 },
 "samp": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "ksel",
    0
   ],
   "sigmas": [
    "sig",
    0
   ],
   "latent_image": [
    "av",
    0
   ]
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "samp",
    0
   ]
  }
 },
 "crop": {
  "class_type": "LTXVCropGuides",
  "inputs": {
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "latent": [
    "sep",
    0
   ]
  }
 },
 "dec": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "samples": [
    "crop",
    2
   ],
   "vae": [
    "vae",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 8
  }
 },
 "adec": {
  "class_type": "LTXVAudioVAEDecode",
  "inputs": {
   "samples": [
    "sep",
    1
   ],
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "sound": {
  "class_type": "ComfySwitchNode",
  "inputs": {
   "switch": "${new_sound}",
   "on_true": [
    "adec",
    0
   ],
   "on_false": [
    "comp",
    1
   ]
  }
 },
 "mk": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "dec",
    0
   ],
   "audio": [
    "sound",
    0
   ],
   "fps": 24.0
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "mk",
    0
   ],
   "filename_prefix": "vfx/ltx_vfx",
   "format": "auto",
   "codec": "auto"
  }
 }
}