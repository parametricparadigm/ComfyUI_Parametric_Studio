{
 "src": {
  "class_type": "LoadVideo",
  "inputs": {
   "file": "${video}"
  }
 },
 "part": {
  "class_type": "Video Slice",
  "inputs": {
   "video": [
    "src",
    0
   ],
   "start_time": 0.0,
   "duration": "${slice_seconds}",
   "strict_duration": false
  }
 },
 "comp": {
  "class_type": "GetVideoComponents",
  "inputs": {
   "video": [
    "part",
    0
   ]
  }
 },
 "first": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "comp",
    0
   ],
   "batch_index": 0,
   "length": 1
  }
 },
 "scale": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "first",
    0
   ],
   "upscale_method": "lanczos",
   "width": "${width}",
   "height": "${height}",
   "crop": "center"
  }
 },
 "high": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.2_fun_camera_high_noise_14B_fp8_scaled.safetensors",
   "weight_dtype": "default"
  }
 },
 "low": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.2_fun_camera_low_noise_14B_fp8_scaled.safetensors",
   "weight_dtype": "default"
  }
 },
 "shift_h": {
  "class_type": "ModelSamplingSD3",
  "inputs": {
   "model": [
    "high",
    0
   ],
   "shift": 8.0
  }
 },
 "shift_l": {
  "class_type": "ModelSamplingSD3",
  "inputs": {
   "model": [
    "low",
    0
   ],
   "shift": 8.0
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "umt5/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
   "type": "wan",
   "device": "default"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "wan/wan_2.1_vae.safetensors"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "text": "${prompt}"
  }
 },
 "neg": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "text": "${negative}"
  }
 },
 "cam": {
  "class_type": "WanCameraEmbedding",
  "inputs": {
   "camera_pose": "${pose}",
   "width": "${width}",
   "height": "${height}",
   "length": "${frames}",
   "speed": 1.0,
   "fx": 0.5,
   "fy": 0.5,
   "cx": 0.5,
   "cy": 0.5
  }
 },
 "i2v": {
  "class_type": "WanCameraImageToVideo",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "vae": [
    "vae",
    0
   ],
   "start_image": [
    "scale",
    0
   ],
   "camera_conditions": [
    "cam",
    0
   ],
   "width": [
    "cam",
    1
   ],
   "height": [
    "cam",
    2
   ],
   "length": [
    "cam",
    3
   ],
   "batch_size": 1
  }
 },
 "k1": {
  "class_type": "KSamplerAdvanced",
  "inputs": {
   "model": [
    "shift_h",
    0
   ],
   "positive": [
    "i2v",
    0
   ],
   "negative": [
    "i2v",
    1
   ],
   "latent_image": [
    "i2v",
    2
   ],
   "add_noise": "enable",
   "noise_seed": "${seed}",
   "steps": 20,
   "cfg": 3.5,
   "sampler_name": "euler",
   "scheduler": "simple",
   "start_at_step": 0,
   "end_at_step": 10,
   "return_with_leftover_noise": "enable"
  }
 },
 "k2": {
  "class_type": "KSamplerAdvanced",
  "inputs": {
   "model": [
    "shift_l",
    0
   ],
   "positive": [
    "i2v",
    0
   ],
   "negative": [
    "i2v",
    1
   ],
   "latent_image": [
    "k1",
    0
   ],
   "add_noise": "disable",
   "noise_seed": 0,
   "steps": 20,
   "cfg": 3.5,
   "sampler_name": "euler",
   "scheduler": "simple",
   "start_at_step": 10,
   "end_at_step": 10000,
   "return_with_leftover_noise": "disable"
  }
 },
 "dec": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "k2",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  }
 },
 "mk": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "dec",
    0
   ],
   "audio": [
    "comp",
    1
   ],
   "fps": 16.0
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "mk",
    0
   ],
   "filename_prefix": "reshoot/reshoot_wan",
   "format": "auto",
   "codec": "auto"
  }
 }
}